rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      // All existing reads/writes, including realtime chat, require school membership.
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').lower().matches('[^\\s@]+@mls[.]ceu[.]edu[.]ph');
    }

    function verified() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function boundedQuery(maximum) {
      return request.query.limit != null
        && request.query.limit <= maximum;
    }

    function validText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum
        && (minimum == 0 || !value.matches('\\s*'));
    }

    function validAutoId(value) {
      return value is string
        && value.matches('[a-zA-Z0-9]{20}');
    }

    function exactKeys(data, keys) {
      return data is map
        && data.keys().hasAll(keys)
        && data.keys().hasOnly(keys);
    }

    function listingPath(listingId) {
      return /databases/$(database)/documents/listings/$(listingId);
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function locations() {
      return [
        'Library', 'PHL Lobby', 'CEU Square', 'Canteen',
        'Gate 1', 'Gate 3', 'Gate 4'
      ];
    }

    function programs() {
      return [
        'ab-comm-media', 'bs-accountancy', 'bs-it', 'bs-ihm',
        'bs-tourism-travel', 'bs-medtech', 'bs-nursing',
        'bs-pharmacy', 'bs-psychology', 'ddm', 'bsned',
        'bsba-intl-mgmt', 'od'
      ];
    }

    function yearLevels() {
      return ['1', '2', '3', '4', '5', '6'];
    }

    function validLocations(values, minimum) {
      return values is list
        && values.size() >= minimum
        && values.size() <= 3
        && values.hasOnly(locations())
        && values.toSet().size() == values.size();
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'displayName', 'bio', 'meetupLocations',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'displayName', 'program', 'yearLevel', 'bio',
          'meetupLocations', 'createdAt', 'updatedAt'
        ])
        && validText(data.displayName, 2, 60)
        && validText(data.bio, 0, 300)
        && (!('program' in data) || data.program in programs())
        && (!('yearLevel' in data) || data.yearLevel in yearLevels())
        && validLocations(data.meetupLocations, 0)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSettings(data) {
      return exactKeys(data, [
          'inAppMessageNotices', 'createdAt', 'updatedAt'
        ])
        && data.inAppMessageNotices is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && boundedQuery(50);

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'program', 'yearLevel', 'bio',
          'meetupLocations', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /private/settings {
        allow get: if isOwner(uid);

        allow create: if isOwner(uid)
          && validSettings(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && validSettings(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'inAppMessageNotices', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time;

        allow list, delete: if false;
      }

      match /likes/{listingId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && boundedQuery(50);

        allow create: if isOwner(uid)
          && verified()
          && validAutoId(listingId)
          && exactKeys(request.resource.data, ['createdAt'])
          && request.resource.data.createdAt == request.time
          && exists(listingPath(listingId))
          && acceptsNewContact(get(listingPath(listingId)).data);

        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    function acceptsNewContact(data) {
      return data.moderationStatus == 'visible'
        && data.status in ['Available', 'Pending'];
    }

    match /listings/{listingId} {
      allow get: if signedIn()
        && (
          resource.data.sellerId == request.auth.uid
          || resource.data.moderationStatus == 'visible'
        );

      allow list: if boundedQuery(50)
        && (
          resource.data.sellerId == request.auth.uid
          || acceptsNewContact(resource.data)
        );

      allow create, update, delete: if false;
    }

    function isParticipant(data) {
      return signedIn()
        && request.auth.uid in data.participants;
    }

    function validConversationCreate(data, conversationId) {
      let listing = get(listingPath(data.listingId)).data;
      return verified()
        && exactKeys(data, [
          'listingId', 'buyerId', 'sellerId', 'participants',
          'listingSnapshot', 'createdAt', 'lastMessageAt', 'lastMessage'
        ])
        && validAutoId(data.listingId)
        && validText(data.buyerId, 1, 128)
        && data.buyerId == request.auth.uid
        && validText(data.sellerId, 1, 128)
        && data.sellerId == listing.sellerId
        && data.buyerId != data.sellerId
        && conversationId == data.listingId + '_' + data.buyerId
        && data.participants == [data.buyerId, data.sellerId]
        && acceptsNewContact(listing)
        && exactKeys(data.listingSnapshot, [
          'title', 'image', 'slug', 'status', 'priceCentavos', 'seller'
        ])
        && data.listingSnapshot.title == listing.title
        && data.listingSnapshot.image == listing.images[0]
        && data.listingSnapshot.slug == listing.slug
        && data.listingSnapshot.status == listing.status
        && data.listingSnapshot.priceCentavos == listing.priceCentavos
        && data.listingSnapshot.seller == listing.seller
        && data.createdAt == request.time
        && data.lastMessageAt == null
        && data.lastMessage == null;
    }

    function isOwnCanonicalId(conversationId) {
      return signedIn()
        && validAutoId(conversationId.split('_')[0])
        && conversationId
          == conversationId.split('_')[0] + '_' + request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (
          (resource != null && isParticipant(resource.data))
          || (
            !exists(conversationPath(conversationId))
            && isOwnCanonicalId(conversationId)
          )
        );

      allow list: if isParticipant(resource.data)
        && boundedQuery(50);

      allow create: if validConversationCreate(
        request.resource.data,
        conversationId
      );

      allow update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if exists(conversationPath(conversationId))
          && isParticipant(get(conversationPath(conversationId)).data);

        allow list: if exists(conversationPath(conversationId))
          && isParticipant(get(conversationPath(conversationId)).data)
          && boundedQuery(100);

        // No client message schema or atomic summary update is implemented yet.
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /uploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /uploadControls/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

